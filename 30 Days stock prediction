import subprocess
import sys
import time

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense, Dropout, Bidirectional
from sklearn.preprocessing import MinMaxScaler
import yfinance as yf

def install_and_import(package):
    try:
        __import__(package)
    except ImportError:
        print(f"Installing {package}...")
        subprocess.check_call([sys.executable, "-m", "pip", "install", package])
        time.sleep(2)
        try:
            __import__(package)
        except ImportError:
            print(f"Failed to install {package}. Please install manually using !pip install {package}")

# Ensure necessary dependencies are installed
packages = ["numpy", "pandas", "matplotlib", "tensorflow", "scikit-learn", "yfinance"]
for package in packages:
    install_and_import(package)

# Step 1: Fetch Stock Data (At Least 5 Years to Ensure Enough Data)
stock_symbol = 'PBBANK.KL'
data = None

try:
    data = yf.download(stock_symbol, period='5y')  # Fetch 5 years of data
    if data.empty or len(data) < 200:
        raise ValueError("Insufficient data fetched. Try a different stock symbol.")
    print("Data fetched successfully for period: 5y")
except Exception as e:
    raise ValueError(f"Error fetching stock data: {e}")

# Step 2: Feature Engineering
min_window = min(50, len(data))
data['SMA_50'] = data['Close'].rolling(window=min_window).mean()
data['SMA_200'] = data['Close'].rolling(window=min(200, len(data))).mean()
data['EMA_20'] = data['Close'].ewm(span=20, adjust=False).mean()
data.ffill(inplace=True)  # Fill missing values instead of dropping

data.dropna(inplace=True)  # Ensure no NaN values remain

if len(data) < 60:
    raise ValueError("Error: Not enough data after feature engineering. Try fetching more data.")

scaler = MinMaxScaler(feature_range=(0, 1))
data[['Close', 'SMA_50', 'SMA_200', 'EMA_20']] = scaler.fit_transform(data[['Close', 'SMA_50', 'SMA_200', 'EMA_20']])

train_size = int(len(data) * 0.8)
train_data, test_data = data.iloc[:train_size], data.iloc[train_size:]

seq_length = 60 if len(train_data) >= 60 and len(test_data) >= 60 else 30

def create_sequences(data, seq_length):
    sequences, labels = [], []
    for i in range(len(data) - seq_length):
        sequences.append(data.iloc[i:i+seq_length].values)
        labels.append(data.iloc[i+seq_length]['Close'])  # Predicting Close price
    return np.array(sequences), np.array(labels)

X_train, y_train = create_sequences(train_data, seq_length)
X_test, y_test = create_sequences(test_data, seq_length)

# Debugging prints
print(f"Training data shape: {X_train.shape}, {y_train.shape}")
print(f"Testing data shape: {X_test.shape}, {y_test.shape}")

if X_train.size == 0 or X_test.size == 0:
    raise ValueError("Error: Training or testing data is empty. Ensure enough historical data is available.")

# Step 3: Build Advanced LSTM Model
model = Sequential([
    Bidirectional(LSTM(units=128, return_sequences=True, input_shape=(seq_length, X_train.shape[2]))),
    Dropout(0.3),
    Bidirectional(LSTM(units=128, return_sequences=False)),
    Dropout(0.3),
    Dense(units=64, activation='relu'),
    Dense(units=32, activation='relu'),
    Dense(units=1)
])

model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=0.0005), loss='mean_squared_error')

# Step 4: Train the Model
epochs = 150  # Increased epochs for better learning
batch_size = 64
model.fit(X_train, y_train, batch_size=batch_size, epochs=epochs, validation_data=(X_test, y_test))

# Step 5: Predict Future Trend (Next 30 Days)
predictions = model.predict(X_test)

future_predictions = []
last_sequence = test_data[-seq_length:].values.copy()
for _ in range(30):  # Predict next 30 days
    last_sequence_input = last_sequence.reshape(1, seq_length, X_test.shape[2])
    next_prediction = model.predict(last_sequence_input)[0, 0]
    if np.isnan(next_prediction):
        print("Warning: NaN detected in prediction, stopping forecast.")
        break
    future_predictions.append(next_prediction)
    new_entry = np.array([next_prediction] + last_sequence[-1, 1:].tolist())
    last_sequence = np.vstack([last_sequence[1:], new_entry])

# Convert predictions back to original scale
future_predictions = np.array(future_predictions).reshape(-1, 1)
if future_predictions.size > 0:
    inverse_transformed = scaler.inverse_transform(
        np.hstack((future_predictions, np.tile(data.iloc[-1, 1:].values, (future_predictions.shape[0], 1)))))
    future_predictions = inverse_transformed[:, 0]

# Generate future dates
future_dates = pd.date_range(start=data.index[-1], periods=len(future_predictions) + 1, freq='B')[1:]

# Debugging Outputs
print(f"Future Predictions: {future_predictions}")
print(f"Future Dates: {future_dates}")
print(f"Future Predictions Shape: {len(future_predictions)}, Future Dates Shape: {len(future_dates)}")

# Ensure correct plotting
plt.figure(figsize=(14,7))
plt.plot(data.index[-len(y_test):], scaler.inverse_transform(
    np.hstack((y_test.reshape(-1, 1), np.tile(data.iloc[-1, 1:].values, (y_test.shape[0], 1)))))[:, 0], color='blue', label='Actual Stock Price', linewidth=2)
plt.plot(data.index[-len(y_test):], scaler.inverse_transform(
    np.hstack((predictions.reshape(-1, 1), np.tile(data.iloc[-1, 1:].values, (predictions.shape[0], 1)))))[:, 0], color='red', linestyle='dashed', label='Predicted Stock Price', linewidth=2)

if len(future_predictions) == len(future_dates):
    plt.plot(future_dates, future_predictions, color='green', linestyle='dashed', marker='o', markersize=4, label='Future Predictions (30 Days)', linewidth=2)
else:
    print("Error: Future predictions and future dates do not align!")

plt.title(f'{stock_symbol} Stock Price Prediction', fontsize=14)
plt.xlabel('Time', fontsize=12)
plt.ylabel('Stock Price', fontsize=12)
plt.legend(fontsize=12)
plt.grid(True, linestyle='--', alpha=0.6)
plt.show()
